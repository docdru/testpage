---
import { getEntry, render } from 'astro:content';
import Logo from '../components/Logo.astro';
import { link, localLink, isExternal, marked } from '../lib/links.js';
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/instrument-sans';
import '../styles/global.css';

// lang: 'de' or 'en'. translated: false shows the "English version in preparation" band.
const { title, description, lang = 'de', translated = true } = Astro.props;
const entry = (await getEntry('site', lang)) ?? (await getEntry('site', 'de'));
const site = entry.data;
const { Content: Footer } = await render(entry);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · ${site.name}` : site.name}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href={link('/favicon.svg')} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <div class="header-row">
          <a class="logo" href={localLink('/', lang)}><Logo /><span>{site.name}</span></a>
          <div class="lang-switch" role="group" aria-label="Sprache / Language">
            <a href={link('/')} aria-current={lang === 'de' ? 'true' : undefined} lang="de">DE</a>
            <a href={link('/en/')} aria-current={lang === 'en' ? 'true' : undefined} lang="en">EN</a>
          </div>
        </div>
        <nav aria-label={lang === 'en' ? 'Main navigation' : 'Hauptnavigation'}>
          {site.menu.map((item) => (
            <a href={localLink(item.href, lang)} {...(isExternal(item.href) ? { rel: 'noopener' } : {})}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>
    {site.notice && <p class="notice"><span class="wrap" set:html={marked(site.notice)} /></p>}
    {!translated && site.translationNotice && (
      <p class="notice translation" lang="en"><span class="wrap" set:html={marked(site.translationNotice)} /></p>
    )}
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <Footer />
      </div>
    </footer>
  </body>
</html>

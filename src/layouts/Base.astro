---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { link, isExternal } from '../lib/links.js';
import '../styles/global.css';

const { title, description } = Astro.props;
const site = (await getEntry('site', 'site')).data;
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href) => (link(href).replace(/\/$/, '') || '/') === current;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · ${site.name}` : site.name}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/png" href={link('/favicon.png')} />
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        const t = localStorage.getItem('theme');
        if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.dataset.theme = 'dark';
        }
      } catch {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href={link('/')}>
          {site.logo && <Image src={site.logo} alt="" width={36} height={36} />}
          <span>{site.name}</span>
        </a>
        <nav>
          {site.menu.map((item) => (
            <a href={link(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}
              {...(isExternal(item.href) ? { rel: 'noopener' } : {})}>{item.label}</a>
          ))}
          <button class="theme-toggle" type="button" aria-label="Toggle theme">◐</button>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <a class="logo small" href={link('/')}>
          {site.logo && <Image src={site.logo} alt="" width={24} height={24} />}
          <span>{site.name}</span>
        </a>
        {site.copyright && <span>© {new Date().getFullYear()} · {site.copyright}</span>}
        <span class="footer-links">
          {site.footerLinks.map((l) => <a href={link(l.href)}>{l.label}</a>)}
        </span>
      </div>
      {site.footer && <p class="wrap footer-note">{site.footer}</p>}
    </footer>
    <script>
      document.querySelector('.theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme !== 'dark';
        if (dark) root.dataset.theme = 'dark'; else delete root.dataset.theme;
        try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
      });
    </script>
  </body>
</html>

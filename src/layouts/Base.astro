---
import { getCollection } from 'astro:content';
import '../styles/global.css';

const { title, description, wide = false } = Astro.props;

// Build links that respect the `base` setting (needed on GitHub Pages project sites).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (path) => `${base}${path}`;
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (path) => (link(path).replace(/\/$/, '') || '/') === current;

// Top menu: Home, then every page in src/content/pages/ that has `menu:` set.
const menuPages = (await getCollection('pages', (p) => p.data.menu !== undefined))
  .sort((a, b) => a.data.menu - b.data.menu);
const nav = [
  { href: '/', label: 'Home' },
  ...menuPages.map((p) => ({ href: `/${p.id}/`, label: p.data.title })),
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · AttentionLab` : 'AttentionLab'}</title>
    {description && <meta name="description" content={description} />}
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="icon" type="image/svg+xml" href={link('/favicon.svg')} />
  </head>
  <body>
    <header>
      <div class="wrap">
        <a class="logo" href={link('/')}>Attention<span>Lab</span></a>
        <nav>
          {nav.map((item) => (
            <a href={link(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <main class:list={[{ wide }]}>
      <div class:list={[wide ? 'full' : 'wrap']}>
        <slot />
      </div>
    </main>
    <footer>
      <div class="wrap">
        <span>© {new Date().getFullYear()} AttentionLab · Verein</span>
        <span><a href={link('/impressum/')}>Impressum</a> · <a href={link('/privacy/')}>Privacy</a></span>
      </div>
    </footer>
  </body>
</html>

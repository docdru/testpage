---
// The AttentionLab mark: a ring with a yellow dot in the middle.
const { size = 26 } = Astro.props;
---
<svg class="logo-mark" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <circle cx="16" cy="16" r="13.5" fill="none" stroke="currentColor" stroke-width="3" />
  <circle cx="16" cy="16" r="6.5" fill="var(--yellow)" />
</svg>

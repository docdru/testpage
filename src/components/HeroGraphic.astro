---
// Original illustration: scattered "distractions" drawn toward a calm centre of focus.
// Pure SVG + CSS, no external images. Swap for a photo later if you like.
const dots = Array.from({ length: 34 }, (_, i) => {
  const angle = (i * 137.5 * Math.PI) / 180; // golden-angle spread
  const radius = 70 + ((i * 53) % 190);
  return {
    cx: 300 + Math.cos(angle) * radius,
    cy: 300 + Math.sin(angle) * radius,
    r: 3 + (i % 4) * 1.6,
    delay: (i % 9) * 0.45,
    tone: i % 5 === 0 ? 'var(--highlight)' : 'var(--accent)',
  };
});
---
<svg class="hero-graphic" viewBox="0 0 600 600" role="img" aria-label="Scattered dots drawn toward a bright centre">
  <defs>
    <radialGradient id="glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#f2c14e" stop-opacity="0.55" />
      <stop offset="60%" stop-color="#f2c14e" stop-opacity="0.08" />
      <stop offset="100%" stop-color="#f2c14e" stop-opacity="0" />
    </radialGradient>
  </defs>

  <circle cx="300" cy="300" r="290" fill="url(#glow)" />

  <g class="rings" fill="none" stroke="var(--accent)">
    <circle cx="300" cy="300" r="250" stroke-opacity="0.08" stroke-width="1.5" />
    <circle cx="300" cy="300" r="190" stroke-opacity="0.12" stroke-width="1.5" stroke-dasharray="4 10" />
    <circle cx="300" cy="300" r="130" stroke-opacity="0.18" stroke-width="2" />
    <circle cx="300" cy="300" r="75" stroke-opacity="0.28" stroke-width="2" stroke-dasharray="2 6" />
  </g>

  <g class="dots">
    {dots.map((d) => (
      <circle cx={d.cx} cy={d.cy} r={d.r} fill={d.tone} fill-opacity="0.75"
        style={`--dx:${(300 - d.cx) * 0.35}px; --dy:${(300 - d.cy) * 0.35}px; animation-delay:${d.delay}s`} />
    ))}
  </g>

  <circle class="core" cx="300" cy="300" r="34" fill="var(--accent)" />
  <circle cx="300" cy="300" r="14" fill="var(--highlight)" />
</svg>

<style>
  .hero-graphic { width: 100%; height: auto; display: block; }
  .rings { transform-origin: 300px 300px; animation: spin 80s linear infinite; }
  .dots circle { animation: drift 6s ease-in-out infinite alternate; }
  .core { transform-origin: 300px 300px; animation: pulse 4s ease-in-out infinite; }

  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes drift { to { transform: translate(var(--dx), var(--dy)); opacity: 0.35; } }
  @keyframes pulse { 50% { transform: scale(1.12); } }

  @media (prefers-reduced-motion: reduce) {
    .rings, .dots circle, .core { animation: none; }
  }
</style>

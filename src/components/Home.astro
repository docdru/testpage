---
// The home page, built from the Markdown files in src/content/home/<lang>/.
// Each file is one block; a block with `section:` starts a new section, the
// blocks after it (without `section:`) are added to that section.
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import DotsArt from './DotsArt.astro';
import { link, marked } from '../lib/links.js';

const { lang = 'de' } = Astro.props;

// Use the blocks of this language. If there are none yet, show the German ones.
const all = await getCollection('home');
const ofLang = (l) => all.filter((e) => e.id.startsWith(`${l}/`));
const translated = ofLang(lang).length > 0;
const entries = (translated ? ofLang(lang) : ofLang('de')).sort((a, b) => a.data.order - b.data.order);

const blocks = await Promise.all(
  entries.map(async (entry) => ({ ...entry.data, Content: (await render(entry)).Content })),
);

const sections = [];
for (const block of blocks) {
  if (block.section || sections.length === 0) {
    sections.push({ id: block.section, panel: block.panel, hero: block.type === 'hero', blocks: [] });
  }
  sections.at(-1).blocks.push(block);
}
---
<Base lang={lang} translated={translated}>
  {sections.map((section) => (
    <section id={section.id} class:list={['section', `panel-${section.panel}`, { 'is-hero': section.hero }]}>
      <div class="wrap">
        <div class="panel">
          {section.blocks.map((b) => {
            const { Content } = b;
            return (
              <div class:list={['block', `type-${b.type}`, `tone-${b.tone}`, { lead: b.lead }]}>
                <div class="block-text reveal">
                  <Content />
                  {b.image && (
                    <figure class="figure">
                      <Image src={b.image} alt={b.imageAlt} widths={[600, 1200]} sizes="(max-width: 760px) 100vw, 60rem" />
                      {b.caption && <figcaption set:html={marked(b.caption)} />}
                    </figure>
                  )}
                  {b.buttons.length > 0 && (
                    <p class="actions">
                      {b.buttons.map((btn, i) => (
                        <a class:list={['button', btn.variant ?? (i === 0 ? 'primary' : 'outline')]} href={link(btn.href)}>{btn.label}</a>
                      ))}
                    </p>
                  )}
                </div>
                {b.type === 'hero' && <div class="hero-art"><DotsArt lang={lang} /></div>}
              </div>
            );
          })}
        </div>
      </div>
    </section>
  ))}
</Base>

<script>
  // Fade content in as it scrolls into view.
  document.querySelectorAll('.type-cards li, .type-quotes li, .type-columns li, .type-dots li, .type-team li')
    .forEach((el) => el.classList.add('reveal'));
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); }
    }
  }, { threshold: 0.1 });
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
</script>

---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { link } from '../lib/links.js';

// The text of this page lives in src/content/home/*.md, one file per section.
const entries = (await getCollection('home')).sort((a, b) => a.data.order - b.data.order);
const sections = await Promise.all(
  entries.map(async (entry) => ({ ...entry.data, Content: (await render(entry)).Content })),
);
---
<Base>
  {sections.map((s) => {
    const { Content } = s;
    const buttons = s.buttons.length > 0 && (
      <p class="actions">
        {s.buttons.map((b, i) => (
          <a class:list={['button', { secondary: i > 0 && s.type === 'hero' }]} href={link(b.href)}>{b.label}</a>
        ))}
      </p>
    );

    if (s.type === 'hero') return (
      <section id={s.id} class="hero">
        <div class="wrap hero-inner">
          <div class="hero-text prose reveal">
            {s.eyebrow && <p class="eyebrow">{s.eyebrow}</p>}
            <Content />
            {buttons}
          </div>
          <div class="hero-art reveal" data-parallax="0.08">
            {s.images.map((img, i) => (
              <Image src={img.src} alt={img.alt} widths={[240, 480]} sizes="(max-width: 760px) 40vw, 240px"
                class:list={['shot', i === 0 ? 'phone' : 'watch']} loading="eager" />
            ))}
          </div>
        </div>
      </section>
    );

    if (s.type === 'feature') return (
      <section id={s.id} class:list={['band', { alt: s.alt }]}>
        <div class="wrap feature">
          {s.image && <Image src={s.image} alt={s.imageAlt} width={1280} widths={[640, 1280]} sizes="(max-width: 760px) 100vw, 50vw" class="feature-img reveal" />}
          <div class="prose reveal">
            {s.eyebrow && <p class="eyebrow">{s.eyebrow}</p>}
            <Content />
            {buttons}
          </div>
        </div>
      </section>
    );

    return (
      <section id={s.id} class:list={['band', `sec-${s.type}`, { alt: s.alt, cta: s.type === 'cta' }]}>
        <div class:list={['wrap prose', `style-${s.style}`, { reveal: s.type === 'text' || s.type === 'cta' }]}>
          {s.eyebrow && <p class="eyebrow">{s.eyebrow}</p>}
          <Content />
          {buttons}
        </div>
      </section>
    );
  })}
</Base>

<script>
  // Fade content in as it scrolls into view.
  document.querySelectorAll('.sec-gallery li, .sec-cards li, .sec-steps li').forEach((el) => el.classList.add('reveal'));
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); }
    }
  }, { threshold: 0.12 });
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

  // Gentle parallax on the hero screenshots.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const layers = document.querySelectorAll('[data-parallax]');
  if (!reduce && layers.length) {
    let ticking = false;
    const update = () => {
      layers.forEach((el) => {
        el.style.translate = `0 ${window.scrollY * parseFloat(el.dataset.parallax || '0')}px`;
      });
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) { requestAnimationFrame(update); ticking = true; }
    }, { passive: true });
  }
</script>
